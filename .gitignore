# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Environments
.venv/
venv/
.env

# Logs
*.log

# Attest's audit history. Created by the service at ATTEST_STORE_PATH (default
# ./attest.db). A run's own record, not source — and it carries agent output.
*.db
*.db-wal
*.db-shm

# DataHub CLI
datapacks/

# Frontend build + deps. The Vite bundle is built by `just ui` and static-mounted by the
# API; both are regenerated, never committed. The vendored SOURCE under frontend/src is
# committed — its build output is not.
frontend/node_modules/
frontend/dist/
# The replay build's intermediate output. `just replay-build` stages it into docs/replay/,
# which IS committed — GitHub Pages serves main//docs and has no build step, so the only way
# a static page reaches a judge is if its built bytes are in the repo.
frontend/dist-replay/

# Generated seed output — rebuild with: python seed/generate_seed.py
# The generator is the source of truth, not its output. Both files carry
# generation timestamps, so committing them is pure churn.
seed/*.json

# Benchmark scratch. The RESULTS are committed — they are the receipts the README quotes,
# and a benchmark whose numbers nobody can see is not evidence.
benchmark/results/_*.log

# A working diagnostic (an external read-only audit's findings). Not a repo artifact — the
# fixes it drove are in the code and history; the report itself is scratch.
AUDIT.md
AUDIT2.md
