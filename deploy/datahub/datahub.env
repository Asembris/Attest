# Environment for the vendored DataHub Core compose (deploy/datahub/docker-compose.yml).
# Passed via `docker compose --env-file`. See docs/deployment.md.
#
# DATAHUB_VERSION pins the image tags to the version Attest's ground truth sits on. Bumping
# it is a deliberate act — the benchmark's oracle cannot sit on a moving branch (CLAUDE.md).
DATAHUB_VERSION=v1.5.0.6

# Token signing secrets. Local metadata auth is DISABLED (METADATA_SERVICE_AUTH_ENABLED is
# 'false' in the compose), so these are unused and blank is correct. Set them only if you
# turn auth on. Never commit real secrets here.
DATAHUB_TOKEN_SERVICE_SALT=
DATAHUB_TOKEN_SERVICE_SIGNING_KEY=

# Blank = the server default. Not used by Attest's path.
UI_INGESTION_DEFAULT_CLI_VERSION=
