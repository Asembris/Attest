# Copy to .env and fill in. .env is gitignored.

# --- OpenAI ---
OPENAI_API_KEY=sk-...

# --- DataHub ---
# Local quickstart GMS. Metadata auth is disabled locally, so the token is empty.
DATAHUB_GMS_URL=http://localhost:8080
DATAHUB_TOKEN=

# --- Models (per pipeline step) ---
# Never hardcode a model in code. Every step resolves its model here, falling
# back to ATTEST_MODEL_DEFAULT when unset. The entailment step is the one most
# likely to need a stronger model than the default.
ATTEST_MODEL_DEFAULT=gpt-4o-mini
ATTEST_MODEL_CLAIM_EXTRACTION=
ATTEST_MODEL_EVIDENCE_SELECTION=
ATTEST_MODEL_ENTAILMENT=
ATTEST_MODEL_VERDICT=
