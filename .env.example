# Copy to .env and fill in. .env is gitignored.

# --- OpenAI ---
OPENAI_API_KEY=sk-...

# --- DataHub ---
# Local quickstart GMS. Metadata auth is disabled locally, so the token is empty.
DATAHUB_GMS_URL=http://localhost:8080
DATAHUB_TOKEN=

# The DataHub UI origin the frontend deep-links to (distinct from GMS above: :9002 is the
# UI, :8080 is the API). Backend-supplied to the SPA over /health, so it is not hardcoded.
DATAHUB_UI_URL=http://localhost:9002

# --- The service ---
# Pinned deliberately. DataHub owns 8080 (GMS) and 9002 (UI) on this machine, and a port
# clash surfaces as an audit that cannot reach the catalog — which reads like an outage.
ATTEST_API_PORT=8003

# Attest's audit history: every run, its evidence, and every human decision.
ATTEST_STORE_PATH=attest.db

# LangGraph's checkpoints: the PAUSED GRAPH of a run parked at the human checkpoint, which
# is what lets it be approved after a restart. A separate file from the audit history on
# purpose — LangGraph owns these tables, Attest owns the other ones. See store.py.
ATTEST_CHECKPOINT_PATH=attest-checkpoints.db

# --- Catalog discovery (the URN picker's search) ---
# MCP discovers. A human resolves. GraphQL verifies. Deterministic code decides.
#
# The picker searches your catalog through the DataHub MCP Server, launched on demand as a
# child process. It is ADVISORY: the only value that crosses into an audit is a URN a person
# picked, and it is verified over GraphQL like any other. The catalog READ stays on GraphQL —
# see docs/mcp-evaluation.md for what was measured when it did not.
#
# Optional in every direction. Without `pip install -e '.[mcp]'` the search answers 501 and the
# picker offers manual URN entry; nothing about an audit depends on it. Set false to switch it
# off entirely.
ATTEST_DISCOVERY_ENABLED=true

# How the MCP server is launched. `--native-tls` is uv's system-CA opt-in, needed on a
# TLS-inspecting network (the same trap as Python's truststore and Node's NODE_USE_SYSTEM_CA).
# Point this at an already-installed server to skip uvx's resolve.
#
# The version is PINNED. Every claim Attest makes about this server is version-bounded (the
# parity finding, and `just spike-mcp` exiting non-zero as a tripwire), and an unpinned
# `--from` resolves whatever is newest at first use. Unpin it and you are running a server
# none of the receipts describe. See docs/mcp-evaluation.md.
# ATTEST_MCP_COMMAND=uvx --native-tls --from mcp-server-datahub==0.6.0 mcp-server-datahub --transport stdio

# Measured on Core v1.5.0.6: spawn+initialize 3.3s, one search 0.13-0.34s. Both budgets are
# ~10x that, so a timeout means something is wrong rather than that the server was busy.
# ATTEST_MCP_STARTUP_TIMEOUT=30
# ATTEST_MCP_CALL_TIMEOUT=10

# --- Models (per pipeline step) ---
# Never hardcode a model in code. Every step resolves its model here, falling
# back to ATTEST_MODEL_DEFAULT when unset. The entailment step is the one most
# likely to need a stronger model than the default.
ATTEST_MODEL_DEFAULT=gpt-4o-mini
ATTEST_MODEL_CLAIM_EXTRACTION=
ATTEST_MODEL_EVIDENCE_SELECTION=
ATTEST_MODEL_ENTAILMENT=
ATTEST_MODEL_VERDICT=
